# Copy to .env and fill in. Never commit .env.

# Must match the key n8n already generated in its volume, or existing credentials can't be decrypted.
# Read it with: docker compose exec n8n cat /home/node/.n8n/config
N8N_ENCRYPTION_KEY=change-me

# Public HTTPS URL that Telegram can reach (e.g. an ngrok or Cloudflare tunnel to port 5679), with trailing slash
WEBHOOK_URL=https://your-tunnel.example.com/

# URL you open the editor on; used for execution links in error alerts
N8N_EDITOR_BASE_URL=http://localhost:5679/

# Postgres holding the tickets table
POSTGRES_DB=sortinel
POSTGRES_USER=sortinel
POSTGRES_PASSWORD=change-me
