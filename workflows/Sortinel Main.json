      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO tickets (ticket_id, received_at, chat_id, message_id, \"user\", text,\n                     category, severity, confidence, reason, status, urlhaus_status)\nVALUES ($1, $2, $3, $4, $5, $6, NULLIF($7, ''), NULLIF($8, ''), NULLIF($9, '')::numeric, $10, $11, $12)\nON CONFLICT (ticket_id) DO UPDATE SET\n  category = EXCLUDED.category, severity = EXCLUDED.severity, confidence = EXCLUDED.confidence,\n  reason = EXCLUDED.reason, status = EXCLUDED.status, urlhaus_status = EXCLUDED.urlhaus_status\nRETURNING *;",
          "options": {
            "queryReplacement": "={{ [$json.ticket_id, $json.received_at ?? null, $json.chat_id ?? null, $json.message_id ?? null, $json.user ?? null, $json.text ?? null, String($json.category ?? ''), String($json.severity ?? ''), String($json.confidence ?? ''), $json.reason ?? null, $json.status, $json.urlhaus_status] }}"
          }
        },
