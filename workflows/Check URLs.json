      ],
      "id": "9bffff06-df83-4748-bb64-91adf3a717c9",
      "name": "Summarise Verdict"
    },
    {
      "parameters": {
        "jsCode": "const urls = ($input.first().json.urls ?? []).slice(0, 5);\nif (!urls.length) return [{ json: { url: null, host: null } }];\nreturn urls.map(url => {\n  let host = null;\n  try { host = new URL(url).hostname; } catch {}\n  return { json: { url, host } };\n});"
      },
