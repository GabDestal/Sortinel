      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const safe = name => { try { return $(name).all().map(i => i.json); } catch { return []; } };\nconst urlRows = safe('URLhaus Lookup');\nconst hostRows = safe('URLhaus Host Lookup');\nconst rows = [...urlRows, ...hostRows];\n\nconst urlHit = urlRows.some(r => r.query_status === 'ok');\nconst hostHit = hostRows.some(r => r.query_status === 'ok');\nconst failed = rows.some(r => r.error);\nconst checked = rows.some(r => r.query_status);\n\nlet urlhaus_status, reply_text;\nif (urlHit) {\n  urlhaus_status = 'known_malicious_url';\n  reply_text = \"This link is on the URLhaus list of known malicious URLs. Don't open it or enter any credentials. If you already did, change your password now. IT has been notified.\";\n} else if (hostHit) {\n  urlhaus_status = 'malicious_host';\n  reply_text = \"The site this link points to is known on URLhaus for hosting malicious content. Don't open it or enter any credentials. If you already did, change your password now. IT has been notified.\";\n} else if (failed) {\n  urlhaus_status = 'lookup_failed';\n  reply_text = \"I couldn't check the link right now, so treat it as malicious: don't open it or enter credentials. If you already did, change your password now. IT has been notified.\";\n} else if (checked) {\n  urlhaus_status = 'not_listed';\n  reply_text = \"The link isn't on the URLhaus malicious list, but still treat it as suspicious: don't enter credentials, and change your password if you already did. IT has been notified.\";\n} else {\n  urlhaus_status = 'no_urls';\n  reply_text = \"Don't click any link in that message or enter credentials. If you already entered your password, change it now. IT has been notified.\";\n}\nreturn [{ json: { status: 'open', reply_text, urlhaus_status } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
